# Epilepsee-AI — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# ─── Weights & Biases ────────────────────────────────────────────────────────
# Get your API key from https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# Optional: W&B project and entity (defaults to epilepsee-ai)
WANDB_PROJECT=epilepsee-ai
WANDB_ENTITY=your_wandb_entity_here

# ─── Dataset paths ───────────────────────────────────────────────────────────
# Path to the SeizeIT2 BIDS dataset (ds005873)
BIDS_DATASET_ROOT=/path/to/datasets/ds005873

# Path to the Oregon Wearable Device dataset (VSM Study Watch)
WEARABLE_DATASET_ROOT=/path/to/datasets/WearableDevice-Oregon

# ─── Training output ─────────────────────────────────────────────────────────
# Where to save models, logs, and visualizations (defaults to ./models)
OUTPUT_DIR=./models
